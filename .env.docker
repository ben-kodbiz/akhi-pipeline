# Akhi Data Builder - Docker Environment Configuration
# Phase 9: Production Dockerization
# Copy this file to .env and customize for your environment

# Application Settings
APP_NAME=akhi-data-builder
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_TIMEOUT=300

# Database Configuration
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# Security Settings
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
API_KEY=your-api-key-change-this-in-production

# Model Configuration
MODEL_PATH=/app/models
DEFAULT_MODEL=akhi_qlora
MAX_TOKENS=512
TEMPERATURE=0.7

# Pipeline Configuration
PIPELINE_DATA_PATH=/app/data
PIPELINE_OUTPUT_PATH=/app/data/crew_outputs
PIPELINE_LOGS_PATH=/app/logs
MAX_CONCURRENT_JOBS=2

# YouTube Processing
YT_DLP_FORMAT=best[height<=720]
WHISPER_MODEL=base
MAX_VIDEO_DURATION=3600

# QLoRA Training
QLORA_ENABLED=true
QLORA_BATCH_SIZE=4
QLORA_LEARNING_RATE=2e-4
QLORA_EPOCHS=3
QLORA_RANK=16
QLORA_ALPHA=32

# Monitoring
METRICS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin123

# Storage
DATA_RETENTION_DAYS=30
LOG_RETENTION_DAYS=7
MODEL_CACHE_SIZE=10GB

# Network Configuration
DOCKER_NETWORK=akhi-network
DOCKER_SUBNET=172.20.0.0/16

# SSL Configuration (for production)
SSL_ENABLED=false
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# External Services
HUGGINGFACE_TOKEN=
OPENAI_API_KEY=
WANDB_API_KEY=

# Resource Limits
MEMORY_LIMIT=8g
CPU_LIMIT=4
GPU_ENABLED=false
GPU_DEVICE_IDS=0

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION=7
BACKUP_PATH=/app/backups